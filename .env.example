# 변수 이름만 둔다. 실제 값은 .env(커밋 금지, CLAUDE.md 6절). docs/02-architecture.md 6절.

# --- DB (로컬 개발: pnpm dev:infra) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://raildex:<password>@127.0.0.1:5440/raildex

# --- 문서 저장소 (S3 호환; 로컬 SeaweedFS, 운영 외부 복제 Cloudflare R2) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=raildex-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=

# --- 관리자 인증 (Cloudflare Access, Q80) ---
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_EMAIL=
# 로컬 개발에서만 1. 운영 이미지(NODE_ENV=production)에서는 무시된다
AUTH_DEV_BYPASS=

# --- 공개 사이트(apps/web) ---
# 공개 API 주소(기본 http://127.0.0.1:5101, 컨테이너 안은 http://api:3000). 옛 시스템의 API_URL(5100)은 쓰지 않는다
PUBLIC_API_URL=http://127.0.0.1:5101
# 범위 public:read 토큰(개발 AUTH_DEV_BYPASS 에서는 비워도 됨)
WEB_API_TOKEN=
# 정규 주소(canonical·OpenGraph). 없으면 http://127.0.0.1:5303
SITE_URL=https://k-raildex.com
# 오류 제보 GitHub 이슈 양식 주소(없으면 "오류 제보" 링크를 숨김)
PUBLIC_ISSUES_URL=
# 포트: 개발 서버(기본 5303) / 컨테이너 게시(기본 5203)
WEB_DEV_PORT=
WEB_PORT=
# 1 이면 운영에서도 응답이 계약(zod)과 다를 때 오류(기본: 기록만)
WEB_STRICT_CONTRACTS=
# next dev 에 localhost 가 아닌 호스트로 접속할 때(쉼표 구분)
DEV_ALLOWED_ORIGINS=

# --- 지도 ---
VWORLD_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- 외부 API (서비스별 변수 → 공통 변수 순으로 조회. 수집기·관리 앱 외부 API 탐색기 공용, 공공데이터포털은 일반 인증키(Decoding)) ---
DATA_GO_KR_KEY=
DATA_GO_KR_KEY_TAGO_SUBWAY=
DATA_GO_KR_KEY_TAGO_TRAIN=
DATA_GO_KR_KEY_KORAIL=
KRIC_KEY=
SEOUL_OPEN_KEY=
LAW_GO_KR_OC=

# --- 에이전트 (후순위) ---
ANTHROPIC_API_KEY=

# --- 배포 ---
CLOUDFLARE_TUNNEL_TOKEN=
